EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Region where Cloud Functions are deployed (must match Firebase, e.g. us-central1)
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# Only if Firestore was created with a custom Database ID (not "(default)"):
# EXPO_PUBLIC_FIRESTORE_DATABASE_ID=your-database-id

# Firebase CLI: set `.firebaserc` default project to the same value as EXPO_PUBLIC_FIREBASE_PROJECT_ID.
# Console: enable Authentication (Email), Cloud Firestore, Cloud Functions, Vertex AI API + billing.
# Deploy rules + functions: npm run firebase:deploy:firestore && npm run firebase:deploy:functions

# --- Optional: AI without Blaze / Cloud Functions (Gemini from device) ---
# Create a key at https://aistudio.google.com/app/apikey then restrict it in Google Cloud Console.
# EXPO_PUBLIC_GEMINI_API_KEY=
# Optional model id for Google AI (cheap default): EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash

# --- Backend Gemini (recommended cheap defaults) ---
# GEMINI_API_KEY=
# GEMINI_MODEL_CHEAP=gemini-2.5-flash
# GEMINI_MODEL_LIVE=gemini-2.5-flash-native-audio-latest
