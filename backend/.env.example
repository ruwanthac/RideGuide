PORT=3000
# Local: mongodb://127.0.0.1:27017/rideguide — Atlas: use the host from Connect (e.g. cluster0.xxxxx.mongodb.net)
MONGODB_URI=mongodb://127.0.0.1:27017/rideguide
JWT_SECRET=replace-me-with-32-plus-random-chars
GEMINI_API_KEY=your-google-ai-studio-key
CORS_ORIGIN=*
NODE_ENV=development
# Admin: allow POST /api/admin/seed-demo (never enable in production; code also blocks production)
ALLOW_ADMIN_SEED=false
# If true with seed-demo: delete non-admin users and related collections before seeding (destructive)
ADMIN_SEED_CLEAR=false

# Transactional email via SMTP (Brevo, Gmail App Password, etc.)
# All four values below must be non-empty non-comment lines or outbound mail is skipped (admin verify still works;
# the dashboard will show the one-time password when email is not sent).
EMAIL_FROM=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional: create/update owner login (min 8 chars). From backend/: DEV_OWNER_PASSWORD="..." npm run ensure-dev-owner
# DEV_OWNER_EMAIL=owner@example.com
# DEV_OWNER_DISPLAY_NAME=Your Name
# DEV_OWNER_PASSWORD=
