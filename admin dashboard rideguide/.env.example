# Canonical RideGuide API (Express in repo `../backend`).
# Optional: if unset, dev server proxies /api → VITE_PROXY_TARGET (see vite.config.ts).
VITE_API_BASE_URL=http://localhost:3000

# Vite dev proxy target when VITE_API_BASE_URL is empty (same-origin /api/*).
VITE_PROXY_TARGET=http://localhost:3000
